# @default-only: `ddev start` copies this file to .env when .env is missing, edit .env on a live checkout, not this file.
#
# Values for development in ddev, none of them is a secret. A production host sets its own variables in the
# environment of the image and never reads a file, see "Deploy the docs site" in the README.
#
# TYPO3__SECTION__key sets $GLOBALS['TYPO3_CONF_VARS']['SECTION']['key'], "__" separates the levels.
# A variable of the process itself wins over the one in this file.

TYPO3_CONTEXT=Development
APP_URL='https://fluid-primitives.ddev.site'
DISABLE_CACHES=true

# Not a secret: the key of a development installation
TYPO3__SYS__encryptionKey='e93ce07b798edb22fff84cccdf4e716978c2f2aa6bc2e857d1ef790e65afe49290a0c6bd898e863313fc12166f7a7963'

TYPO3__DB__Connections__Default__host=db
TYPO3__DB__Connections__Default__dbname=db
TYPO3__DB__Connections__Default__user=db
TYPO3__DB__Connections__Default__password=db

# All mail goes to mailpit
TYPO3__MAIL__transport=smtp
TYPO3__MAIL__transport_smtp_server=localhost:1025
TYPO3__MAIL__transport_smtp_encrypt=false
