page.10.paths.10 = EXT:demos/Resources/Private/PageView/

lib.content < styles.content.get

# The header of every page, uncached: it shows who is logged in
lib.userMenu = EXTBASEPLUGIN
lib.userMenu {
    extensionName = Demos
    pluginName = UserMenu
}

plugin.tx_news {
    view {
        templateRootPaths.10 = EXT:demos/Resources/Private/Extensions/News/Templates/
        partialRootPaths.10 = EXT:demos/Resources/Private/Extensions/News/Partials/
    }
    settings {
        cssFile =
        # The filters of the list set the search, the categories and the page of the demand
        disableOverrideDemand = 0
        orderBy = datetime
        orderDirection = desc
        # Without a conjunction the categories of the demand are ignored
        categoryConjunction = or
        search {
            fields = teaser,title,bodytext
            paginate.itemsPerPage = 6
        }
    }
}
