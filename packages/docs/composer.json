{
    "name": "fluid-primitives/docs",
    "type": "typo3-cms-extension",
    "description": "",
    "homepage": "https://joostramke.com",
    "license": [
        "GPL-2.0-or-later"
    ],
    "keywords": [
        "TYPO3 CMS"
    ],
    "require": {
        "typo3/cms-core": "^14"
    },
    "autoload": {
        "psr-4": {
            "FluidPrimitives\\Docs\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FluidPrimitives\\Docs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php vendor/bin/phpunit -c phpunit.xml --testdox --colors=always --display-notices",
        "test:fromdocs": "php ../../vendor/bin/phpunit -c phpunit.xml --testdox --colors=always --display-notices"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "docs"
        }
    }
}
