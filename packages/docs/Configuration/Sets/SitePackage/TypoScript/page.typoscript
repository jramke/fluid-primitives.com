##############
#### PAGE ####
##############
page = PAGE
page {
    typeNum = 0

    10 = PAGEVIEW
    10 {
        paths {
            0 = EXT:docs/Resources/Private/PageView/
        }
    }

    shortcutIcon = EXT:docs/Resources/Public/Favicons/favicon.ico
    headerData.1754921028 = COA
    headerData.1754921028 {
        10 = IMG_RESOURCE
        10 {
            file = EXT:docs/Resources/Public/Favicons/favicon.svg
            stdWrap.dataWrap = <link rel="icon" href="|" type="image/svg+xml">
        }
        20 = IMG_RESOURCE
        20 {
            file = EXT:docs/Resources/Public/Favicons/apple-touch-icon.png
            stdWrap.dataWrap = <link rel="apple-touch-icon" href="|">
        }
    }

    headerData.1754921029 = USER
    headerData.1754921029 {
        userFunc = FluidPrimitives\Docs\Services\UmamiService->renderScriptTag
    }

    meta {
        viewport = {$page.meta.viewport}
        robots = {$page.meta.robots}
        apple-mobile-web-app-capable = {$page.meta.apple-mobile-web-app-capable}

        X-UA-Compatible = {$page.meta.compatible}
        X-UA-Compatible {
            attribute = http-equiv
        }

        og:image.cObject = TEXT
        og:image.cObject {
            typolink {
                parameter.cObject = IMG_RESOURCE
                parameter.cObject.file = EXT:docs/Resources/Public/Images/og-image.png
                returnLast = url
                forceAbsoluteUrl = 1
            }
        }
    }
}

# The `.md` response - see DocsMarkdownModeMiddleware::MARKDOWN_TYPE_NUM and
# DocsMarkdownModeResponder::respondWithContentIfActive(). Renders `lib.docsPlugin` directly rather than
# through PAGEVIEW, so DocsController's markdown response body becomes the entire output with no HTML
# layout wrapped around it - same idiom EXT:seo uses for its XML sitemap typeNum. Its own typeNum also
# gives it its own page-cache identity, separate from the plain HTML page at the same path.
pageMarkdown = PAGE
pageMarkdown {
    typeNum = 9576

    10 < lib.docsPlugin

    config {
        disableAllHeaderCode = 1
        cache_period = 3600
        additionalHeaders {
            10.header = Content-Type: text/markdown; charset=utf-8
        }
    }
}
