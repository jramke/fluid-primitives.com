        "Control": {
            "data-scope": "date-input",
            "data-part": "control",
            "data-disabled": "Present when disabled",
            "data-readonly": "Present when read-only",
            "data-invalid": "Present when invalid",
            "data-focus": "Present when focused"
        },
        "SegmentGroup": {
            "data-scope": "date-input",
            "data-part": "segment-group",
            "data-disabled": "Present when disabled",
