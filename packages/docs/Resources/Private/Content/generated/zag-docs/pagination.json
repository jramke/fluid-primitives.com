                "type": "number | undefined",
                "description": "Total number of data items"
            },
            "pageSize": {
                "type": "number | undefined",
                "description": "The controlled number of data items per page"
            },
            "defaultPageSize": {
                "type": "number | undefined",
                "description": "The initial number of data items per page when rendered.\nUse when you don't need to control the page size of the pagination.",
                "defaultValue": "10"
            },
            "siblingCount": {
                "type": "number | undefined",
                "description": "Number of pages to show beside active page",
                "defaultValue": "1"
            },
            "boundaryCount": {
                "type": "number | undefined",
                "description": "Number of pages to show at the beginning and end",
                "defaultValue": "1"
            },
            "page": {
                "type": "number | undefined",
                "description": "The controlled active page"
            },
            "defaultPage": {
                "type": "number | undefined",
                "description": "The initial active page when rendered.\nUse when you don't need to control the active page of the pagination.",
                "defaultValue": "1"
            },
            "onPageChange": {
                "type": "((details: PageChangeDetails) => void) | undefined",
                "description": "Called when the page number is changed"
            },
            "onPageSizeChange": {
                "type": "((details: PageSizeChangeDetails) => void) | undefined",
                "description": "Called when the page size is changed"
            },
            "type": {
                "type": "\"button\" | \"link\" | undefined",
                "description": "The type of the trigger element",
                "defaultValue": "\"button\""
            },
            "getPageUrl": {
                "type": "((details: PageUrlDetails) => string) | undefined",
                "description": "Function to generate href attributes for pagination links.\nOnly used when `type` is set to \"link\"."
            },
            "dir": {
                "type": "\"ltr\" | \"rtl\" | undefined",
                "description": "The document's text/writing direction.",
                "defaultValue": "\"ltr\""
            },
            "id": {
                "type": "string",
                "description": "The unique identifier of the machine."
            },
            "getRootNode": {
                "type": "(() => ShadowRoot | Document | Node) | undefined",
